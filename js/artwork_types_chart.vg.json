{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 560,
  "height": 390,

  "data": {
    "url": "Data/qagoma_artwork_types.csv",
    "format": {
      "type": "csv",
      "parse": {
        "count": "number"
      }
    }
  },

  "encoding": {

    "y": {
      "field": "category",
      "type": "nominal",
      "sort": {
        "field": "count",
        "order": "descending"
      },
      "title": null,

      "axis": {
        "labelFontSize": 13,
        "labelColor": "#333333",
        "labelPadding": 10,
        "labelLimit": 170,
        "ticks": false,
        "domain": false
      }
    },

    "x": {
      "field": "count",
      "type": "quantitative",

      "title": "Number of artworks",

      "scale": {
        "domain": [0, 5500]
      },

      "axis": {
        "title": "Number of artworks",
        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "titleColor": "#4f4a43",
        "titlePadding": 12,

        "labelFontSize": 11,
        "labelColor": "#666666",

        "grid": true,
        "gridColor": "#e6e0d7",
        "gridOpacity": 1,

        "domain": true,
        "domainColor": "#b9ae9d",

        "ticks": true,
        "tickColor": "#b9ae9d",

        "values": [
          0,
          1000,
          2000,
          3000,
          4000,
          5000
        ],

        "labelExpr": "format(datum.value, ',')"
      }
    }
  },

  "layer": [

    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 5,
        "color": "#d7b36a",
        "height": 22
      },

      "encoding": {
        "tooltip": [
          {
            "field": "category",
            "type": "nominal",
            "title": "Artwork type"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Number of artworks",
            "format": ","
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#3b231f"
      },

      "encoding": {
        "text": {
          "field": "count",
          "type": "quantitative",
          "format": ","
        }
      }
    }

  ],

  "config": {
    "background": null,

    "view": {
      "stroke": null
    },

    "font": "Arial"
  }
}