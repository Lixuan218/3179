{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 900,
  "height": 430,

  "padding": {
    "left": 10,
    "right": 10,
    "top": 10,
    "bottom": 120
  },

  "data": {
    "url": "Data/qagoma_collection_diversity.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rank": "number",
        "count": "number",
        "share_percent": "number",
        "cumulative_percent": "number"
      }
    }
  },

  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal",

      "sort": {
        "field": "rank",
        "order": "ascending"
      },

      "axis": {
        "title": "Artwork category",

        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "titleColor": "#4f4a43",
        "titlePadding": 25,

        "labelAngle": -50,
        "labelAlign": "right",
        "labelBaseline": "top",

        "labelFontSize": 10,
        "labelColor": "#4f4a43",
        "labelPadding": 8,
        "labelLimit": 150,

        "domain": true,
        "domainColor": "#b9ae9d",

        "ticks": true,
        "tickColor": "#b9ae9d",
        "tickSize": 5
      }
    }
  },

  "layer": [

    {
      "mark": {
        "type": "bar",
        "color": "#d7b36a",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4
      },

      "encoding": {

        "y": {
          "field": "count",
          "type": "quantitative",
          "title": "Number of artworks",

          "scale": {
            "domain": [0, 5500]
          },

          "axis": {
            "titleFontSize": 12,
            "labelFontSize": 11,

            "grid": true,
            "gridColor": "#e6e0d7",

            "domain": false,
            "ticks": false,

            "values": [
              0,
              1000,
              2000,
              3000,
              4000,
              5000
            ],

            "labelExpr": "format(datum.value, ',')"
          }
        },

        "tooltip": [
          {
            "field": "category",
            "type": "nominal",
            "title": "Artwork category"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Artworks",
            "format": ","
          },
          {
            "field": "share_percent",
            "type": "quantitative",
            "title": "Share",
            "format": ".2f"
          },
          {
            "field": "cumulative_percent",
            "type": "quantitative",
            "title": "Cumulative share",
            "format": ".2f"
          }
        ]
      }
    },


    {
      "mark": {
        "type": "line",
        "color": "#3b231f",
        "strokeWidth": 3,

        "point": {
          "filled": true,
          "fill": "#3b231f",
          "stroke": "#ffffff",
          "strokeWidth": 1.5,
          "size": 65
        }
      },

      "encoding": {

        "y": {
          "field": "cumulative_percent",
          "type": "quantitative",
          "title": "Cumulative share (%)",

          "scale": {
            "domain": [0, 100]
          },

          "axis": {
            "orient": "right",

            "titleFontSize": 12,
            "labelFontSize": 11,

            "grid": false,
            "domain": false,
            "ticks": false,

            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],

            "labelExpr": "datum.value + '%'"
          }
        },

        "order": {
          "field": "rank",
          "type": "quantitative",
          "sort": "ascending"
        },

        "tooltip": [
          {
            "field": "category",
            "type": "nominal",
            "title": "Artwork category"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Artworks",
            "format": ","
          },
          {
            "field": "share_percent",
            "type": "quantitative",
            "title": "Share",
            "format": ".2f"
          },
          {
            "field": "cumulative_percent",
            "type": "quantitative",
            "title": "Cumulative share",
            "format": ".2f"
          }
        ]
      }
    },


    {
      "data": {
        "values": [
          {
            "threshold": 80
          }
        ]
      },

      "mark": {
        "type": "rule",
        "color": "#a45d3f",
        "strokeDash": [6, 5],
        "strokeWidth": 1.5
      },

      "encoding": {

        "x": {
          "value": 0
        },

        "x2": {
          "value": 900
        },

        "y": {
          "field": "threshold",
          "type": "quantitative",

          "scale": {
            "domain": [0, 100]
          },

          "axis": null
        }
      }
    },


    {
      "data": {
        "values": [
          {
            "threshold": 80,
            "label": "80% cumulative share"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -5,

        "fontSize": 11,
        "fontWeight": "bold",

        "color": "#a45d3f"
      },

      "encoding": {

        "x": {
          "value": 450
        },

        "y": {
          "field": "threshold",
          "type": "quantitative",

          "scale": {
            "domain": [0, 100]
          },

          "axis": null
        },

        "text": {
          "field": "label"
        }
      }
    }

  ],

  "resolve": {
    "scale": {
      "y": "independent"
    }
  },

  "config": {

    "background": null,

    "font": "Arial",

    "view": {
      "stroke": null
    },

    "axis": {
      "labelColor": "#4f4a43",
      "titleColor": "#4f4a43"
    }
  }
}